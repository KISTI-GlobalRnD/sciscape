# =============================================================================
# SciScape Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# --- LLM Configuration (Cluster Naming + Stage 7 Canonicalization) -----------
# Both modules use OpenAI-compatible endpoints (e.g. Ollama, vLLM, OpenAI).
#
# SCISCAPE_LLM_BASE_URL: API endpoint URL
# SCISCAPE_LLM_API_KEY:  API key (use "ollama" for local Ollama)
# SCISCAPE_LLM_MODEL:    Model identifier

SCISCAPE_LLM_BASE_URL=http://localhost:11434/v1
SCISCAPE_LLM_API_KEY=ollama
SCISCAPE_LLM_MODEL=gpt-oss:20b

# Legacy variables (still supported, overridden by SCISCAPE_LLM_* if both set):
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gpt-oss:20b
# OPENAI_API_KEY=sk-...

# --- Database Configuration (Core Documents Fetcher) -------------------------
# Used by sciscape.clustering.core_documents to fetch paper metadata from DB.

CLUSTER_DB_DRIVER=sqlite
CLUSTER_DB_PATH=./workspace/data/papers.db
# CLUSTER_DB_HOST=localhost
# CLUSTER_DB_PORT=3306
# CLUSTER_DB_USER=
# CLUSTER_DB_PASSWORD=
# CLUSTER_DB_NAME=

# Table names
CLUSTER_META_TABLE=paper_metadata
# CLUSTER_METRIC_TABLE=
# CLUSTER_TITLE_TABLE=
# CLUSTER_ABSTRACT_TABLE=
# CLUSTER_YEAR_TABLE=
# CLUSTER_CITATION_TABLE=
# CLUSTER_TEMP_TABLE=

# Column names
CLUSTER_UID_COL=uid
CLUSTER_TITLE_COL=title
CLUSTER_ABSTRACT_COL=abstract
CLUSTER_YEAR_COL=pubyear
CLUSTER_CITATION_COL=citation_count
