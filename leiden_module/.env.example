# Ollama / local LLM configuration
# Copy this file to .env and adjust values for your environment.

OLLAMA_BASE_URL=http://172.16.2.42:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gpt-oss:20b

# Database configuration for core document selection
CLUSTER_DB_DRIVER=sqlite  # or mysql

# SQLite settings
CLUSTER_DB_PATH=/path/to/wos.sqlite

# MySQL settings (only used when CLUSTER_DB_DRIVER=mysql)
CLUSTER_DB_HOST=172.16.0.122
CLUSTER_DB_PORT=3306
CLUSTER_DB_NAME=web_of_science_2526_raw
CLUSTER_DB_USER=global_adm
CLUSTER_DB_PASSWORD=Kisti1234!
CLUSTER_TEMP_TABLE=tmp_cluster_uids

CLUSTER_META_TABLE=paper_metadata
CLUSTER_METRIC_TABLE=paper_metrics
CLUSTER_TITLE_TABLE=paper_metadata
CLUSTER_ABSTRACT_TABLE=paper_metadata
CLUSTER_YEAR_TABLE=paper_metadata
CLUSTER_CITATION_TABLE=paper_metrics
CLUSTER_UID_COL=uid
CLUSTER_TITLE_COL=title
CLUSTER_ABSTRACT_COL=abstract
CLUSTER_YEAR_COL=pubyear
CLUSTER_CITATION_COL=citation_count
